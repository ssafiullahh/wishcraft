# ollama (default) or openai_compatible
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
LLM_BASE_URL=http://ollama:11434
# For an OpenAI-compatible service, set provider, base URL, model and server-side key.
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=replace-me
LLM_TIMEOUT_SECONDS=45
# Optional secondary provider for model/network outages. Keep its key server-side.
# LLM_FALLBACK_PROVIDER=openai_compatible
# LLM_FALLBACK_MODEL=gpt-4o-mini
# LLM_FALLBACK_BASE_URL=https://api.openai.com/v1
# LLM_FALLBACK_API_KEY=replace-me
MAX_CONCURRENT_LLM_REQUESTS=3
RATE_LIMIT_PER_MINUTE=30
MAX_API_REQUEST_BYTES=32768
WISHCRAFT_DB_PATH=backend/data/wishcraft.sqlite3
# Console spans are enabled by default; set an OTLP collector to export them.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# Set false to disable console spans when no OTLP endpoint is configured.
# OTEL_CONSOLE_EXPORTER=false
CORS_ORIGINS=*
LOG_LEVEL=INFO
